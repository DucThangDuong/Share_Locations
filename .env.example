# 1. SQL Server
MSSQL_SA_PASSWORD=ChangeThisPassword123!
SQLSERVER_PORT=14333

# 2. Redis Cache
REDIS_PORT=63799

# 3. Backend API
BACKEND_PORT=5000
JWT_SECRET_KEY=YOUR_SUPER_SECRET_KEY_AT_LEAST_32_CHARACTERS_LONG

# 4. Frontend Web Client
FRONTEND_PORT=3000
